# Gradle wrapper 必须是 LF 换行符 + 可执行权限
gradlew text eol=lf

# Kotlin / Gradle / 配置与文档源码统一 LF
*.kt text eol=lf
*.kts text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf

# 二进制文件
*.jks binary
*.jar binary
*.apk binary

# 默认自动检测文本文件
* text=auto
